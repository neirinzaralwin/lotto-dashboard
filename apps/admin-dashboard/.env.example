NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only — never expose to the browser or mobile app
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Push: configure on Supabase as Edge secret FIREBASE_SERVICE_ACCOUNT_JSON
# (not needed in Next.js env — send-push reads it at runtime)
